table Dim_Productos
	lineageTag: ae4ba91c-c12f-4d5a-a2d3-ff5f6a6419df

	partition Dim_Productos = m
		mode: import
		source =
				let
				    // 1. Origen: CSV en UTF-8 separado por comas
				    Origen = Csv.Document(File.Contents("C:\Users\wiljo\OneDrive\Escritorio\Trabajo final de Power BI\data\raw\Dim_Productos.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    // 2. La primera fila del CSV son los encabezados
				    EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    // 3. Eliminar productos sin ID (null o vacio); se hace antes de tipar para no generar errores de conversion
				    SinIdNulo = Table.SelectRows(EncabezadosPromovidos, each [ID Producto] <> null and [ID Producto] <> ""),
				    // 4. Tipos: el costo usa punto decimal, por eso se lee con configuracion regional en-US
				    TiposCorrectos = Table.TransformColumnTypes(SinIdNulo, {
				        {"ID Producto", Int64.Type},
				        {"Producto", type text},
				        {"Marca", type text},
				        {"Costo Unitario", type number},
				        {"Grupo Contribución", type text},
				        {"Grupo Margen", type text},
				        {"Color", type text},
				        {"Tiempo de Espera (dias)", Int64.Type},
				        {"Es articulo refrigerado", type text}
				    }, "en-US")
				in
				    TiposCorrectos
