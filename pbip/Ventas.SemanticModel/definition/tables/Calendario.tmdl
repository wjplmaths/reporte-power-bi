table Calendario
	dataCategory: Time
	lineageTag: d978f7f5-cc7c-4cb2-a189-7ffbfbf5696e

	column Date
		dataType: dateTime
		formatString: d/M/yyyy
		lineageTag: 4eabf344-6c26-4b0c-90d8-e421beff70df
		summarizeBy: none
		isKey
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Año
		dataType: int64
		formatString: 0
		lineageTag: e0decad8-4307-452a-af5c-154052827f0b
		summarizeBy: none
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		lineageTag: bdf40c3a-5ed2-4328-a079-a50a0051dd4a
		summarizeBy: none
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	column Mes_Num
		dataType: int64
		formatString: 0
		lineageTag: 71ebc41d-4e5d-42ba-bc56-f9cabaa5f10d
		summarizeBy: none
		sourceColumn: [Mes_Num]

		annotation SummarizationSetBy = Automatic

	column Mes_Corto
		dataType: string
		lineageTag: 1df0a1ee-60a0-4e54-88ef-eb26cd451ec1
		summarizeBy: none
		sortByColumn: Mes_Num
		sourceColumn: [Mes_Corto]

		annotation SummarizationSetBy = Automatic

	column Mes_Largo
		dataType: string
		lineageTag: ebdb42b7-3071-45c5-bc19-d7a13e78bd7a
		summarizeBy: none
		sortByColumn: Mes_Num
		sourceColumn: [Mes_Largo]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2020, 1, 1), DATE(2023, 12, 31)),
				    "Año", YEAR([Date]),
				    "Trimestre", QUARTER([Date]) & " Trim",
				    "Mes_Num", MONTH([Date]),
				    "Mes_Corto", UPPER(FORMAT([Date], "MMM", "es-ES")),
				    "Mes_Largo", UPPER(FORMAT([Date], "MMMM", "es-ES"))
				)

	annotation PBI_ResultType = Table
