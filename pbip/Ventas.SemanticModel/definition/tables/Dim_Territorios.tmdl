table Dim_Territorios
	lineageTag: ce9bea94-cb67-4e31-8b98-13f73fd37d57

	column Departamento
		dataType: string
		lineageTag: 25d07bcc-73dc-4684-aeb7-1c9ef5935a3f
		summarizeBy: none
		sourceColumn: Departamento

		annotation SummarizationSetBy = Automatic

	column Cabecera
		dataType: string
		lineageTag: 9bdb69bb-fb6e-4df5-a2ba-b01075b0e586
		summarizeBy: none
		sourceColumn: Cabecera

		annotation SummarizationSetBy = Automatic

	column 'Población (2023)'
		dataType: int64
		formatString: 0
		lineageTag: e5a26d97-e9d1-42e0-ab8d-54da8fd5290d
		summarizeBy: none
		sourceColumn: Población (2023)

		annotation SummarizationSetBy = Automatic

	column 'Superficie (km²)'
		dataType: double
		lineageTag: 7ee1bc90-17b5-47b6-872d-cf0cef2d2354
		summarizeBy: sum
		sourceColumn: Superficie (km²)

		annotation SummarizationSetBy = Automatic

	partition Dim_Territorios = m
		mode: import
		source =
				let
				    Origen = Web.Page(Web.Contents("https://es.wikipedia.org/wiki/Nicaragua")),
				    // 1. Elegir la tabla por contenido (los Id "Table N" de Web.Page no son estables): la que tiene la columna "Cabecera"
				    Candidatas = Table.SelectRows(Origen, each try (List.Contains(Table.ColumnNames([Data]), "Cabecera") or List.AnyTrue(List.Transform(Table.ToColumns([Data]), (c) => List.Contains(c, "Cabecera")))) otherwise false),
				    Datos = Candidatas{0}[Data],
				    // 2. Eliminar filas superiores: todo lo que esta antes de la fila de encabezados (la que contiene "Departamento"); si no hay ninguna, no se quita nada
				    PosEncabezado = List.PositionOf(List.Transform(Table.ToRows(Datos), (f) => List.Contains(List.Transform(f, (v) => if v = null then "" else Text.Trim(Text.From(v))), "Departamento")), true),
				    SinFilasSuperiores = Table.Skip(Datos, List.Max({PosEncabezado, 0})),
				    EncabezadosPromovidos = if PosEncabezado = -1 then SinFilasSuperiores else Table.PromoteHeaders(SinFilasSuperiores, [PromoteAllScalars=true]),
				    // 3. Columnas que usa el modelo. Se buscan por prefijo del encabezado ("ISO:NI58" trae nota) y, si hay varias con el mismo prefijo
				    //    (p. ej. una columna aparte para la bandera, vacia), se toma la que tiene mas celdas con texto
				    LlenasDe = (n as text) as number => List.Count(List.Select(Table.Column(EncabezadosPromovidos, n), (v) => v <> null and Text.Trim(Text.From(v)) <> "")),
				    Col = (prefijo as text) as text => List.First(List.Sort(List.Select(Table.ColumnNames(EncabezadosPromovidos), (n) => Text.StartsWith(Text.Trim(n), prefijo)), (a, b) => Value.Compare(LlenasDe(b), LlenasDe(a)))),
				    NombreDepartamento = Col("Departamento"),
				    NombreCabecera = Col("Cabecera"),
				    NombrePoblacion = Col("Población"),
				    NombreSuperficie = Col("Superficie"),
				    ColumnasUtiles = Table.SelectColumns(EncabezadosPromovidos, {NombreDepartamento, NombreCabecera, NombrePoblacion, NombreSuperficie}),
				    Renombradas = Table.RenameColumns(ColumnasUtiles, {{NombreDepartamento, "Departamento"}, {NombreCabecera, "Cabecera"}, {NombrePoblacion, "Población (2023)"}, {NombreSuperficie, "Superficie (km²)"}}),
				    // 4. Eliminar filas inferiores sin datos: la nota "* Fuente: Estimación del 2023 - INIDE", filas vacias y cualquier fila sin cifras de población
				    SinFilasInferiores = Table.SelectRows(Renombradas, each [Departamento] <> null and Text.Trim(Text.From([Departamento])) <> "" and not Text.StartsWith(Text.Trim(Text.From([Departamento])), "*") and [#"Población (2023)"] <> null and Text.Trim(Text.From([#"Población (2023)"])) <> ""),
				    // 5. Tipos: se quitan notas entre corchetes ("[3]"); las cifras llegan con coma de miles ("188,809"), se dejan digitos y punto decimal
				    SinNotas = (v) => Text.Trim(Text.BeforeDelimiter(Text.From(v), "[")),
				    TiposCorrectos = Table.TransformColumns(SinFilasInferiores, {
				        {"Departamento", each SinNotas(_), type text},
				        {"Cabecera", each SinNotas(_), type text},
				        {"Población (2023)", each Number.FromText(Text.Select(SinNotas(_), {"0".."9", "."}), "en-US"), Int64.Type},
				        {"Superficie (km²)", each Number.FromText(Text.Select(SinNotas(_), {"0".."9", "."}), "en-US"), type number}
				    })
				in
				    TiposCorrectos

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

