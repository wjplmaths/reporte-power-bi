	partition Fact_Ventas = m
		mode: import
		source =
				let
				    // 1. Origen: hoja Fact_Ventas sin promover encabezados (la hoja trae titulo en las filas superiores)
				    Origen = Excel.Workbook(File.Contents("C:\Users\wiljo\OneDrive\Escritorio\Trabajo final de Power BI\data\raw\Fact_Ventas.xlsx"), null, false),
				    Hoja = Origen{[Item="Fact_Ventas",Kind="Sheet"]}[Data],
				    // 2. Eliminar las 3 filas superiores (titulo "CONSOLIDADO DE VENTAS 2020-2023" y filas vacias)
				    FilasSuperioresEliminadas = Table.Skip(Hoja, 3),
				    // 3. La fila 4 de la hoja trae los encabezados reales
				    EncabezadosPromovidos = Table.PromoteHeaders(FilasSuperioresEliminadas, [PromoteAllScalars=true]),
				    // 4. Conservar solo las columnas que usa el modelo (descarta la columna A vacia, la L sin datos,
				    //    ID Factura, Fecha de Envio y Tasa de Impuesto)
				    ColumnasUtiles = Table.SelectColumns(EncabezadosPromovidos, {"ID Transacción", "ID Vendedor", "ID Cliente", "ID Producto", "Fecha de Venta", "Cantidad", "Precio Unitario"}),
				    // 5. Quitar filas sin ID de transaccion (filas vacias al final de la hoja, si las hubiera)
				    SinFilasVacias = Table.SelectRows(ColumnasUtiles, each [ID Transacción] <> null),
				    // 6. Tipos: IDs y cantidad como entero, fecha como date, precio como numero decimal
				    TiposCorrectos = Table.TransformColumnTypes(SinFilasVacias, {
				        {"ID Transacción", Int64.Type},
				        {"ID Vendedor", Int64.Type},
				        {"ID Cliente", Int64.Type},
				        {"ID Producto", Int64.Type},
				        {"Fecha de Venta", type date},
				        {"Cantidad", Int64.Type},
				        {"Precio Unitario", type number}
				    })
				in
				    TiposCorrectos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

