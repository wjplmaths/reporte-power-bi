	partition Dim_Clientes = m
		mode: import
		source =
				let
				    // 1. Origen: CSV en UTF-8 separado por comas
				    Origen = Csv.Document(File.Contents("C:\Users\wiljo\OneDrive\Escritorio\Trabajo final de Power BI\data\raw\Dim_Clientes.csv"), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    // 2. La primera fila del CSV son los encabezados
				    EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    // 3. Eliminar clientes sin ID (null o vacio); se hace antes de tipar para no generar errores de conversion
				    SinIdNulo = Table.SelectRows(EncabezadosPromovidos, each [ID Cliente] <> null and [ID Cliente] <> ""),
				    // 4. Nombres cortos para las dos regiones autonomas del Caribe
				    CaribeNorte = Table.ReplaceValue(SinIdNulo, "Región Autónoma de la Costa Caribe Norte", "Costa Caribe Norte", Replacer.ReplaceValue, {"Departamento"}),
				    CaribeSur = Table.ReplaceValue(CaribeNorte, "Región Autónoma de la Costa Caribe Sur", "Costa Caribe Sur", Replacer.ReplaceValue, {"Departamento"}),
				    // 5. Tipos: ID entero, fecha d/m/aaaa leida con configuracion regional es-ES, el resto texto
				    TiposCorrectos = Table.TransformColumnTypes(CaribeSur, {
				        {"ID Cliente", Int64.Type},
				        {"Nombre Cliente", type text},
				        {"Fecha de Alta", type date},
				        {"Departamento", type text},
				        {"País", type text}
				    }, "es-ES")
				in
				    TiposCorrectos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table
