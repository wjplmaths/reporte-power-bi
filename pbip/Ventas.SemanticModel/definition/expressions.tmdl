/// Convierte la tabla CSV de metas de un anio (vendedor x 12 meses) en filas ID_Vendedor, Fecha, Meta.
expression fnMetasMensuales =
		(Origen as table) as table =>
		let
		    // 1. Promover encabezados: la primera fila del CSV trae "ID_vendedor" y los meses como texto d/m/aaaa (1/1/2020, 1/2/2020...)
		    EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
		    // 2. Nombre estandar de la columna de vendedor
		    IdRenombrado = Table.RenameColumns(EncabezadosPromovidos, {{"ID_vendedor", "ID_Vendedor"}}),
		    // 3. Anular dinamizacion de todas las columnas excepto ID_Vendedor: una fila por vendedor y mes
		    MesesEnFilas = Table.UnpivotOtherColumns(IdRenombrado, {"ID_Vendedor"}, "Fecha", "Meta"),
		    // 4. Fecha: el encabezado es texto d/M/aaaa; se convierte con formato y cultura fijos (no depende de la region del equipo)
		    // 5. Meta: llega como texto con formato de moneda ("C$277,701.30" o "251,625.83"); se dejan solo digitos y punto decimal
		    TiposCorrectos = Table.TransformColumns(MesesEnFilas, {
		        {"ID_Vendedor", each Number.FromText(Text.Trim(_), "en-US"), Int64.Type},
		        {"Fecha", each Date.FromText(Text.Trim(_), [Format="d/M/yyyy", Culture="en-US"]), type date},
		        {"Meta", each Number.FromText(Text.Select(Text.From(_), {"0".."9", "."}), "en-US"), type number}
		    })
		in
		    TiposCorrectos
	lineageTag: 4ed913b6-101d-4b79-9dad-17f560d6c99d
	annotation PBI_ResultType = Function

expression Metas_2020 =
		let
		    // Origen: hoja "Metas 2020" del libro de G.Drive (publico), exportada como CSV por Web
		    Origen = Csv.Document(Web.Contents("https://docs.google.com/spreadsheets/d/1BbiT3b81T7sEzpAFW7_ks5qU07rEeHal/export?format=csv&gid=853825651"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    // Los pasos de transformacion estan en fnMetasMensuales (son los mismos para los 4 anios)
		    Metas = fnMetasMensuales(Origen)
		in
		    Metas
	lineageTag: 9ba78bc4-8b32-4585-bedf-ec14b565ddc6
	annotation PBI_ResultType = Table

