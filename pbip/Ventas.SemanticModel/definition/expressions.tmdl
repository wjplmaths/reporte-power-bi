expression Metas_2020 =
		let
		    // 1. Origen: hoja "Metas 2020" del libro de G.Drive (publico), exportada como CSV por Web
		    Origen = Csv.Document(Web.Contents("https://docs.google.com/spreadsheets/d/1BbiT3b81T7sEzpAFW7_ks5qU07rEeHal/export?format=csv&gid=853825651"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    // 2. Eliminar filas superiores: todo lo que hay antes de la fila de encabezados ("ID_vendedor"); en el CSV actual son 0 filas
		    PosEncabezado = List.PositionOf(List.Transform(Table.ToRows(Origen), each Text.Trim(Text.From(_{0}))), "ID_vendedor"),
		    FilasSuperioresEliminadas = Table.Skip(Origen, List.Max({PosEncabezado, 0})),
		    // 3. Promover la fila de encabezados (ID_vendedor y los meses como texto d/m/aaaa: 1/1/2020, 1/2/2020...)
		    EncabezadosPromovidos = Table.PromoteHeaders(FilasSuperioresEliminadas, [PromoteAllScalars=true]),
		    // 4. Eliminar "Columna 1": cualquier columna sobrante sin encabezado (en el CSV actual no hay ninguna)
		    ColumnasUtiles = Table.SelectColumns(EncabezadosPromovidos, List.Select(Table.ColumnNames(EncabezadosPromovidos), each not Text.StartsWith(_, "Column"))),
		    // 5. Nombre estandar de la columna de vendedor
		    IdRenombrado = Table.RenameColumns(ColumnasUtiles, {{"ID_vendedor", "ID_Vendedor"}}),
		    // 6. Anular dinamizacion de todas las columnas a partir de ID_Vendedor: una fila por vendedor y mes
		    MesesEnFilas = Table.UnpivotOtherColumns(IdRenombrado, {"ID_Vendedor"}, "Atributo", "Valor"),
		    // 7. Renombrar las columnas por "Fecha" y "Meta"
		    ColumnasRenombradas = Table.RenameColumns(MesesEnFilas, {{"Atributo", "Fecha"}, {"Valor", "Meta"}}),
		    // 8. Tipos: Fecha es texto d/M/aaaa y se convierte con formato y cultura fijos; Meta llega con formato de moneda ("C$277,701.30" o "251,625.83") y se dejan solo digitos y punto decimal
		    TiposCorrectos = Table.TransformColumns(ColumnasRenombradas, {
		        {"ID_Vendedor", each Number.FromText(Text.Trim(_), "en-US"), Int64.Type},
		        {"Fecha", each Date.FromText(Text.Trim(_), [Format="d/M/yyyy", Culture="en-US"]), type date},
		        {"Meta", each Number.FromText(Text.Select(Text.From(_), {"0".."9", "."}), "en-US"), type number}
		    })
		in
		    TiposCorrectos
	lineageTag: 9ba78bc4-8b32-4585-bedf-ec14b565ddc6

	annotation PBI_ResultType = Table

