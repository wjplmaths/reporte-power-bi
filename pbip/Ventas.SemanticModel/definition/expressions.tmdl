expression GDrive_Fuente =
		let
		    Origen = Web.Page(Web.Contents("https://docs.google.com/spreadsheets/d/1BbiT3b81T7sEzpAFW7_ks5qU07rEeHal/edit?gid=1022144234"))
		in
		    Origen
	lineageTag: e09a58c0-d4fd-4ad5-88d9-0d644fadcf58

/// Devuelve la tabla de Web.Page que contiene todos los textos de Claves (sin distinguir mayusculas). Los Id "Table N" de Web.Page no son estables.
expression fnBuscarTabla =
		(Fuente as table, Claves as list) as table =>
		let
		    Celdas = (t as table) as list => List.Combine({Table.ColumnNames(t)} & List.Transform(Table.ToColumns(t), (c) => List.Transform(c, (v) => if v = null then "" else Text.Lower(Text.From(v))))),
		    ContieneTodo = (t as table) as logical => List.AllTrue(List.Transform(Claves, (k) => List.Contains(List.Transform(Celdas(t), Text.Lower), Text.Lower(k)))),
		    Halladas = Table.SelectRows(Fuente, each try ContieneTodo([Data]) otherwise false)
		in
		    Halladas{0}[Data]
	lineageTag: 6f2db7c1-4905-4fd8-8249-8361bda0e067
