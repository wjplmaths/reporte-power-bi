{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "Tema Ventas",
  "dataColors": ["#1F3864", "#E69F00", "#56B4E9", "#009E73", "#CC79A7", "#D55E00", "#8C6D1F", "#6C757D"],
  "good": "#2E8B57",
  "neutral": "#E6A800",
  "bad": "#C00000",
  "maximum": "#1F3864",
  "center": "#56B4E9",
  "minimum": "#E6F0FA",
  "null": "#BDBDBD",
  "foreground": "#252423",
  "foregroundNeutralSecondary": "#605E5C",
  "background": "#FFFFFF",
  "secondaryBackground": "#F3F4F6",
  "tableAccent": "#1F3864",
  "textClasses": {
    "callout":         { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F3864" },
    "title":           { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "header":          { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "label":           { "fontSize": 10, "fontFace": "Segoe UI", "color": "#252423" },
    "largeTitle":      { "fontSize": 20, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "dataTitle":       { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "boldLabel":       { "fontSize": 10, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "semiboldLabel":   { "fontSize": 10, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "largeLabel":      { "fontSize": 12, "fontFace": "Segoe UI", "color": "#252423" },
    "largeLightLabel": { "fontSize": 12, "fontFace": "Segoe UI", "color": "#605E5C" },
    "lightLabel":      { "fontSize": 10, "fontFace": "Segoe UI", "color": "#605E5C" },
    "smallLabel":      { "fontSize": 9,  "fontFace": "Segoe UI", "color": "#252423" },
    "smallLightLabel": { "fontSize": 9,  "fontFace": "Segoe UI", "color": "#605E5C" },
    "smallDataLabel":  { "fontSize": 9,  "fontFace": "Segoe UI", "color": "#252423" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{
          "show": true, "alignment": "left", "fontFamily": "Segoe UI Semibold", "fontSize": 12,
          "fontColor": { "solid": { "color": "#252423" } }, "bold": false
        }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E5EA" } }, "radius": 8, "width": 1 }],
        "dropShadow": [{
          "show": true, "color": { "solid": { "color": "#000000" } }, "transparency": 88,
          "shadowBlur": 6, "shadowDistance": 2, "angle": 90, "position": "Outer"
        }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }]
      }
    },
    "cardVisual": {
      "*": {
        "value": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 26, "fontColor": { "solid": { "color": "#1F3864" } } }],
        "label": [{ "fontFamily": "Segoe UI", "fontSize": 11, "fontColor": { "solid": { "color": "#605E5C" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E5E7EB" } }, "gridHorizontalWeight": 1,
          "gridVertical": false, "rowPadding": 3, "textSize": 10
        }],
        "columnHeaders": [{
          "fontFamily": "Segoe UI Semibold", "fontSize": 10,
          "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F3864" } }
        }],
        "values": [{
          "fontFamily": "Segoe UI", "fontSize": 10, "fontColorPrimary": { "solid": { "color": "#252423" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F8FAFC" } }
        }],
        "total": [{
          "fontFamily": "Segoe UI Semibold", "fontSize": 10, "bold": true,
          "fontColor": { "solid": { "color": "#1F3864" } }, "backColor": { "solid": { "color": "#E6F0FA" } }
        }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [{ "show": true, "fontFamily": "Segoe UI", "fontSize": 10, "labelColor": { "solid": { "color": "#252423" } }, "gridlineShow": false }],
        "valueAxis": [{
          "show": true, "fontFamily": "Segoe UI", "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } },
          "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E5E7EB" } }, "gridlineThickness": 1
        }],
        "labels": [{ "show": true, "fontFamily": "Segoe UI", "fontSize": 10, "color": { "solid": { "color": "#252423" } } }],
        "legend": [{ "show": true, "position": "Top", "fontFamily": "Segoe UI", "fontSize": 10, "labelColor": { "solid": { "color": "#252423" } } }]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "categoryAxis": [{ "show": true, "fontFamily": "Segoe UI", "fontSize": 10, "labelColor": { "solid": { "color": "#252423" } }, "gridlineShow": false }],
        "valueAxis": [{
          "show": true, "fontFamily": "Segoe UI", "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } },
          "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E5E7EB" } }, "gridlineThickness": 1
        }],
        "labels": [{ "show": false, "fontFamily": "Segoe UI", "fontSize": 10, "color": { "solid": { "color": "#252423" } } }],
        "legend": [{ "show": true, "position": "Top", "fontFamily": "Segoe UI", "fontSize": 10, "labelColor": { "solid": { "color": "#252423" } } }],
        "lineStyles": [{ "strokeWidth": 3, "showMarker": true, "markerSize": 5 }]
      }
    },
    "gauge": {
      "*": {
        "calloutValue": [{ "show": true, "fontFamily": "Segoe UI Semibold", "color": { "solid": { "color": "#1F3864" } } }],
        "labels": [{ "show": true, "fontFamily": "Segoe UI", "fontSize": 10, "color": { "solid": { "color": "#605E5C" } } }],
        "target": [{ "show": true, "fontFamily": "Segoe UI", "fontSize": 10, "color": { "solid": { "color": "#252423" } } }]
      }
    },
    "kpi": {
      "*": {
        "indicator": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 30, "fontColor": { "solid": { "color": "#1F3864" } } }],
        "goals": [{ "fontFamily": "Segoe UI", "fontSize": 11, "goalFontColor": { "solid": { "color": "#605E5C" } } }],
        "status": [{ "goodColor": { "solid": { "color": "#2E8B57" } }, "neutralColor": { "solid": { "color": "#E6A800" } }, "badColor": { "solid": { "color": "#C00000" } } }]
      }
    },
    "azureMap": {
      "*": {
        "mapControls": [{ "defaultStyle": "road", "showStylePicker": false, "showNavigationControls": true }],
        "legend": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontFamily": "Segoe UI Semibold", "textSize": 11, "fontColor": { "solid": { "color": "#252423" } } }],
        "items": [{ "fontFamily": "Segoe UI", "textSize": 10, "fontColor": { "solid": { "color": "#252423" } }, "background": { "solid": { "color": "#FFFFFF" } } }]
      }
    }
  }
}