{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "Tema Ventas Corporativo",
  "dataColors": [
    "#0B2545",
    "#2A9D8F",
    "#E9A23B",
    "#8DA9C4",
    "#9B2C5B",
    "#5C6B7A",
    "#C8553D",
    "#A8B3BF"
  ],
  "good": "#2E7D32",
  "neutral": "#F9A825",
  "bad": "#B71C1C",
  "maximum": "#0B2545",
  "center": "#E9A23B",
  "minimum": "#DCE6F1",
  "null": "#B0B8C2",
  "foreground": "#1B1F24",
  "foregroundNeutralSecondary": "#5C6B7A",
  "background": "#FFFFFF",
  "secondaryBackground": "#EEF1F5",
  "tableAccent": "#0B2545",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#1B1F24"
    },
    "largeTitle": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "dataTitle": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "boldLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "semiboldLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "largeLabel": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#1B1F24"
    },
    "largeLightLabel": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#5C6B7A"
    },
    "lightLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5C6B7A"
    },
    "smallLabel": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#1B1F24"
    },
    "smallLightLabel": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5C6B7A"
    },
    "smallDataLabel": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#1B1F24"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1B1F24"
              }
            },
            "bold": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#C9D2DC"
              }
            },
            "radius": 2,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 93,
            "shadowBlur": 3,
            "shadowDistance": 1,
            "angle": 90,
            "position": "Outer"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 26,
            "fontColor": {
              "solid": {
                "color": "#0B2545"
              }
            }
          }
        ],
        "label": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#5C6B7A"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#DDE3EA"
              }
            },
            "gridHorizontalWeight": 1,
            "gridVertical": false,
            "rowPadding": 3,
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B2545"
              }
            }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColorPrimary": {
              "solid": {
                "color": "#1B1F24"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "backColor": {
              "solid": {
                "color": "#DCE6F1"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#1B1F24"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5C6B7A"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#DDE3EA"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "labels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#1B1F24"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#1B1F24"
              }
            }
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#1B1F24"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5C6B7A"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#DDE3EA"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "labels": [
          {
            "show": false,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#1B1F24"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#1B1F24"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": true,
            "markerSize": 5
          }
        ]
      }
    },
    "gauge": {
      "*": {
        "calloutValue": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#0B2545"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#5C6B7A"
              }
            }
          }
        ],
        "target": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#1B1F24"
              }
            }
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 30,
            "fontColor": {
              "solid": {
                "color": "#0B2545"
              }
            }
          }
        ],
        "goals": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "goalFontColor": {
              "solid": {
                "color": "#5C6B7A"
              }
            }
          }
        ],
        "status": [
          {
            "goodColor": {
              "solid": {
                "color": "#2E7D32"
              }
            },
            "neutralColor": {
              "solid": {
                "color": "#F9A825"
              }
            },
            "badColor": {
              "solid": {
                "color": "#B71C1C"
              }
            }
          }
        ]
      }
    },
    "azureMap": {
      "*": {
        "mapControls": [
          {
            "defaultStyle": "road",
            "showStylePicker": false,
            "showNavigationControls": true
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "textSize": 11,
            "fontColor": {
              "solid": {
                "color": "#1B1F24"
              }
            }
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1B1F24"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
  }
}
